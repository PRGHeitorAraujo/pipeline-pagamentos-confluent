# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai pro Git.

# --- Postgres (Neon) -------------------------------------------------------
# Use o host DIRETO (sem "-pooler" no nome). Replicação lógica não passa pelo pooler.
PG_HOST=ep-exemplo-123456.us-east-1.aws.neon.tech
PG_PORT=5432
PG_DB=neondb
PG_USER=neondb_owner
PG_PASSWORD=troque-me

# --- Confluent Cloud -------------------------------------------------------
# Mesma nuvem/região do Neon = menos latência e sem custo de tráfego entre regiões.
CC_CLOUD=aws
CC_REGION=us-east-1
CC_ENV_NAME=payments-pipeline
CC_CLUSTER_NAME=payments-cluster
CC_POOL_NAME=payments-flink
CC_POOL_MAX_CFU=5

# --- Local -----------------------------------------------------------------
# No Windows (Git Bash) normalmente é "python"; no WSL/Linux/macOS, "python3".
PY=python3
